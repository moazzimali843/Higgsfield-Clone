{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/capture.py sessionStart",
        "failClosed": false
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 .cursor/hooks/capture.py beforeSubmitPrompt",
        "failClosed": false
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python3 .cursor/hooks/capture.py afterAgentResponse",
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/capture.py stop",
        "failClosed": false
      }
    ]
  }
}
